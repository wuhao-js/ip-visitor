{
  "name": "ip-visitor",
  "version": "1.1.0",
  "description": "服务器来访IP查看：解析 tcpdump 入站流量（TCP/UDP/ICMP），SQLite 存储，密码授权的 Web 实时/历史/统计查看",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "start:replay": "node src/server.js --replay test/samples/sample.log --loop",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node24-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ssh2": "^1.17.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.1",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.lailu.app",
    "productName": "来路",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "to": "lailu-core.exe",
        "from": "dist/ip-visitor-core.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "lailu-setup-${version}.exe"
    },
    "nsis": {
      "shortcutName": "来路",
      "oneClick": false,
      "installerHeaderIcon": "",
      "createStartMenuShortcut": true,
      "uninstallerIcon": "",
      "installerIcon": "",
      "createDesktopShortcut": true,
      "uninstallDisplayName": "来路",
      "allowToChangeInstallationDirectory": true
    }
  },
  "productName": "来路"
}
