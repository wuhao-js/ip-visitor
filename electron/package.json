{
  "name": "ip-visitor-app",
  "version": "1.1.0",
  "description": "来路 LaiLu 桌面壳：内嵌内核服务 + 独立窗口",
  "main": "main.js",
  "productName": "来路",
  "build": {
    "appId": "com.lailu.desktop",
    "productName": "来路",
    "extraResources": [
      {
        "to": "lailu-core.exe",
        "from": "../dist/ip-visitor-core.exe"
      }
    ],
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "F:/ip-visitor/build/app.ico",
      "artifactName": "来路-Setup-${version}.exe"
    },
    "nsis": {
      "uninstallDisplayName": "来路",
      "shortcutName": "来路",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "installDirName": "来路",
      "uninstallerIcon": "F:/ip-visitor/build/app.ico",
      "installerIcon": "F:/ip-visitor/build/app.ico"
    },
    "asar": false,
    "electronVersion": "44.7.2",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "../dist-release"
    }
  }
}
